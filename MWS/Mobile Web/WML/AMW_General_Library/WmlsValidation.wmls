extern function validateSignUp()
{
var chkFName =WMLBrowser.getVar("FName");
var chkLName =WMLBrowser.getVar("LName");
var chkuserName =WMLBrowser.getVar("userName");
var chkpassword =WMLBrowser.getVar("password");

if((chkFName =="" )|| (chkLName =="") || (chkuserName =="") || (chkpassword ==""))
{
	Dialogs.alert("Please fill the boxes");
}
else
{
WMLBrowser.go("3-SignUp.aspx");
}
}

extern function validateLogin()
{
var chkuserName =String.trim(WMLBrowser.getVar("userName"));
var chkpassword =String.trim(WMLBrowser.getVar("password"));

	if( chkuserName =="" )
	{
		WMLBrowser.setVar("usermass", "Please enter your User Name");
		WMLBrowser.refresh();
	}
	if( chkpassword =="")
	{
		WMLBrowser.setVar("passmass", "Please enter your Password");
		WMLBrowser.refresh();
	}
}

extern function validAddBook()
{
var chkTitle =WMLBrowser.getVar("Title");
var chkType =WMLBrowser.getVar("Type");
var chkPrice =WMLBrowser.getVar("Price");
var chkpubId =WMLBrowser.getVar("pubId");
var chkAuthorId =WMLBrowser.getVar("AuthorId");

if(( chkTitle =="" )|| ( chkType =="")|| ( chkPrice =="")|| ( chkpubId =="")|| ( chkAuthorId ==""))
Dialogs.alert("Please fill the boxes");
}

extern function validAddPublisher()
{
